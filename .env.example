# Vision (Claude)
ANTHROPIC_API_KEY=

# Storage provider: local | azure | gcs
storage_provider=local

# Azure Storage (if storage_provider=azure)
azure_storage_connection_string=
azure_storage_container=
azure_sas_expiry_minutes=60

# Azure Cosmos DB (optional)
cosmos_enabled=false
cosmos_endpoint=
cosmos_key=
cosmos_db=
cosmos_scans_container=scans
cosmos_users_container=users

# Firestore/GCS (optional)
firestore_enabled=false
gcp_project_id=
gcs_bucket_name=

# Pipeline thresholds (optional)
image_quality_min_score=50
sharpness_threshold=50
preprocess_max_dim=1024
jpeg_quality=85
confidence_threshold=0.70
angle_enforcement=false

